{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Edgible/card-kit/main/card.schema.json",
  "title": "Edgible card",
  "description": "Source of truth for a shareable pattern. A valid card has no device name, device id, hostname, organization id, password, or volume data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "applications"
  ],
  "properties": {
    "apiVersion": {
      "const": "v1"
    },
    "kind": {
      "const": "Card"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Name of the pattern."
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/application"
      }
    },
    "places": {
      "type": "object",
      "description": "Optional. The minimum recommended machine for each place: everything that runs in that place together. Keys are place names used by the applications.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/place"
      }
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "what",
        "from",
        "port",
        "protocol",
        "subtype",
        "published",
        "authModes",
        "place"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Application name. Copied from metadata.name of edgible application export."
        },
        "what": {
          "type": "string",
          "minLength": 1,
          "description": "What this program is. Two apps that are one process say so here."
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "description": "Image name. An existing-app export does not record it. Read it from docker ps by matching the port. No device and no organization."
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "description": "Database image in the same Compose file, when the program does not run alone."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Host port. Copied from the workload containerPort of the export."
        },
        "protocol": {
          "enum": [
            "https",
            "tcp",
            "udp"
          ],
          "description": "https for web apps. tcp or udp for apps that are not web, such as a game server or SSH; those have no auth mode, so authModes is [none], and their port is from 20000 to 29999."
        },
        "subtype": {
          "const": "existing",
          "description": "The process is already listening on this port before the stack file is deployed."
        },
        "published": {
          "const": true
        },
        "authModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "org",
              "api-key"
            ]
          },
          "description": "none is the auth mode None. An export that says edgible-login is written org."
        },
        "place": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Topology name, not a device name and not a device id. Applications with the same place run on one serving device. Two applications that are one process share a place, a port, and a from."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "enum": [
                  "tcp",
                  "udp"
                ]
              }
            },
            "required": [
              "protocol"
            ]
          },
          "then": {
            "properties": {
              "authModes": {
                "const": [
                  "none"
                ]
              },
              "port": {
                "minimum": 20000,
                "maximum": 29999
              }
            }
          }
        }
      ]
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory": {
          "$ref": "#/$defs/size",
          "description": "Memory for everything in the place together."
        },
        "disk": {
          "$ref": "#/$defs/size",
          "description": "Disk for the images and the data to start with."
        },
        "arch": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "amd64",
              "arm64",
              "arm"
            ]
          },
          "description": "CPU architectures every image in the place runs on."
        },
        "gpu": {
          "enum": [
            "none",
            "optional",
            "required"
          ],
          "description": "Whether the place needs a GPU."
        }
      }
    },
    "size": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)? (MB|GB|TB)$",
      "description": "Such as 512 MB or 2 GB."
    }
  }
}
